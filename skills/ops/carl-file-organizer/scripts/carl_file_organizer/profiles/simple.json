  "name_patterns": [],
  "sensitive": {
    "exact_names": [
      ".env",
      ".netrc",
      "credentials.json",
      "id_rsa",
      "id_ed25519",
      "secrets.json"
    ],
    "exact_stems": [
      "key",
      "keys",
      "env",
      "pass",
      "token",
      "secret",
      "auth"
    ],
    "suffixes": [
      ".cer",
      ".crt",
      ".pem",
      ".p12",
      ".pfx",
      ".mobileprovision",
      ".env"
    ],
    "markers": [
      "credential",
      "password",
      "passwd",
      "apikey",
      "api-key",
      "api_key",
      "private-key",
      "recovery",
      "secret"
    ],
    "marker_min_len": 5
  },
  "pinned": [
    "carl-file-organizer-*.json"
  ],
  "forbidden": {
    "basenames": [
      ".git",
      "Library",
      "Keychains",
      "Messages",
      "Mail"
    ],
    "suffixes": [
      ".photoslibrary",
      ".aplibrary",
      ".sparsebundle",
      ".vmwarevm",
      ".pvm"
    ],
    "markers": [
      ".obsidian"
    ],
    "glob": [
      "Profile *",
      "Photos Library*"
    ]
  },
  "regenerable": {
    "basenames": [
      "node_modules",
      ".next",
      "dist",
      "build",
      "coverage",
      "__pycache__"
    ],
    "scan_depth": 3,
    "restore": {
      "_default": {
        "zh": "由构建再生",
        "en": "regenerated by the build"
      }
    }
  },
  "derivative_hints": [
    "-copy",
    " copy",
    "-backup"
  ],
  "archive_suffixes": [
    ".zip",
    ".tar.gz",
    ".tgz",
    ".tar",
    ".7z",
    ".rar",
    ".gz",
    ".xz",
    ".bz2"
  ],
  "installer_suffixes": [
    ".dmg",
    ".pkg",
    ".iso",
    ".exe",
    ".msi",
    ".apk"
  ],
  "dedupe": {
    "hash_max_bytes": 2147483648,
    "copy_patterns": [
      "^(?P<base>.+?) \\((?P<n>\\d+)\\)(?P<ext>\\.[^.]+)?$",
      "^(?P<base>.+?)_(?P<n>\\d+)(?P<ext>\\.[^.]+)?$"
    ]
  },
  "tags": {
    "group_by_user_tags": false
  },
  "guard": {
    "reference_files": [],
    "reference_scan_roots": [
      "$HOME",
      "$HOME/bin",
      "$HOME/.local/bin",
      "/usr/local/bin",
      "/opt/homebrew/bin"
    ],
    "recent_minutes": 10,
    "lsof_timeout_s": 5
  },
  "large_bytes": 524288000
}
