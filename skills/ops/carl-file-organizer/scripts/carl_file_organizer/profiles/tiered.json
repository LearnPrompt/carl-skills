{
  "profile": "tiered",
  "profile_version": 1,
  "lang": null,
  "managed_dir": {
    "zh": "00_下载目录管理",
    "en": "00_File_Organizer"
  },
  "transient_tag": {
    "zh": "文件移动",
    "en": "Moved by File Organizer"
  },
  "review_log": {
    "zh": "人工调整日志.md",
    "en": "review-log.md"
  },
  "names": {
    "inbox": {
      "zh": "00_收件箱",
      "en": "00_Inbox"
    },
    "inbox.pending": {
      "zh": "待判断",
      "en": "Pending"
    },
    "inbox.by_tag": {
      "zh": "按标签",
      "en": "By_Tag"
    },
