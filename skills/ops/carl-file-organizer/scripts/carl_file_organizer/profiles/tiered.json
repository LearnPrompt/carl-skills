    },
    "library.docs.pdf": {
      "zh": "PDF",
      "en": "PDF"
    },
    "library.docs.ppt": {
      "zh": "PPT",
      "en": "PPT"
    },
    "library.docs.csv": {
      "zh": "CSV",
